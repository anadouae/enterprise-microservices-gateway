# Copy to .env and adjust. Never commit .env or real secrets.
#
# API Gateway: when set, every /api/** request must include header X-API-Key.
# Leave empty to disable auth (local H2 demos only).
GATEWAY_API_KEY=dev-local-change-me

# Optional overrides (docker-compose defaults are fine for local)
# ORDER_SERVICE_URI=http://order-service:8081
# INVENTORY_SERVICE_URI=http://inventory-service:8082
# QUERY_SERVICE_URI=http://query-service:8083
